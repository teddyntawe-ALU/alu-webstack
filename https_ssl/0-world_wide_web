#!/usr/bin/env bash
# Displays the record type and destination of a domain's subdomains
audit_subdomain () {
	local domain="$1"
	local subdomain="$2"
	dig "$subdomain.$domain" | awk -v sub_name="$subdomain" '/ANSWER SECTION:/ { getline; printf "The subdomain %s is a %s record and points to %s\n", sub_name, $4, $5 }'
}

if [ -n "$2" ]
then
	audit_subdomain "$1" "$2"
else
	for subdomain in www lb-01 web-01 web-02
	do
		audit_subdomain "$1" "$subdomain"
	done
fi
