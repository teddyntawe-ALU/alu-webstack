global
	log /dev/log local0
	log /dev/log local1 notice
	maxconn 2048
	user haproxy
	group haproxy
	daemon
	tune.ssl.default-dh-param 2048
	h1-case-adjust x-served-by X-Served-By
	h1-case-adjust location Location

defaults
	log global
	mode http
	option httplog
	option dontlognull
	option forwardfor
	option h1-case-adjust-bogus-client
	timeout connect 5000
	timeout client 50000
	timeout server 50000

frontend http_front
	bind *:80
	http-request redirect scheme https code 301 unless { ssl_fc }
	default_backend web_servers

frontend https_front
	bind *:443 ssl crt /etc/haproxy/certs/www.teddyntawe.tech.pem
	http-request set-header X-Forwarded-Proto https
	default_backend web_servers

backend web_servers
	balance roundrobin
	server 7123-web-01 35.178.153.123:80 check
	server 7123-web-02 3.9.132.43:80 check
